<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD Polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig><vendor>M.G Linux Toolbox</vendor><action id="com.mg.linuxtoolbox.apps"><description>Install or remove an approved catalog app, or configure the Flatpak/Snap runtime it needs</description><message>Authentication is required to install or remove this app, or to configure its Flatpak/Snap runtime</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults><annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mg-linux-toolbox/mg-linux-toolbox-apps-helper</annotate></action></policyconfig>
